{
  "name": "@psud/desktop",
  "version": "1.0.0",
  "description": "PSUD Studio Desktop Application",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "electron .",
    "package": "electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.441.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.5.4",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.psud.studio",
    "productName": "PSUD Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "../installer/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "../installer/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../installer/icons/icon.png"
    }
  }
}